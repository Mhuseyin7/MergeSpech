# Required for database-backed deployment
DATABASE_URL="postgresql://mergespech:change-me@postgres:5432/mergespech?schema=public"
REDIS_URL="redis://redis:6379"
# GitHub App credentials (never expose these in NEXT_PUBLIC variables)
