GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
# OAuth is used only for human dashboard login.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
# Use a randomly generated value of at least 32 characters in production.
SESSION_SECRET=""
APP_URL="http://localhost:3000"
